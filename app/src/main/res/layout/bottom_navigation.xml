<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottom_nav_root"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@color/card_background"
    android:elevation="8dp"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <LinearLayout
        android:id="@+id/nav_home_item"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/nav_home_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/nav_home"
            android:src="@drawable/ic_nav_home"
            app:tint="@color/text_secondary" />

        <TextView
            android:id="@+id/nav_home_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/nav_home"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/nav_documents_item"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/nav_documents_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/nav_documents"
            android:src="@drawable/ic_nav_docs"
            app:tint="@color/text_secondary" />

        <TextView
            android:id="@+id/nav_documents_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/nav_documents"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/nav_ai_item"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/nav_ai_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/nav_ai"
            android:src="@drawable/ic_nav_ai"
            app:tint="@color/text_secondary" />

        <TextView
            android:id="@+id/nav_ai_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/nav_ai"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/nav_settings_item"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/nav_settings_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/nav_settings"
            android:src="@drawable/ic_nav_settings"
            app:tint="@color/text_secondary" />

        <TextView
            android:id="@+id/nav_settings_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/nav_settings"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>

